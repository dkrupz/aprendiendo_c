...@_plantilla

direction: down

inicio: inicio {class: terminal}
cont1: cont1 = 0 {class: entrada}
cont2: cont2 = 0 {class: entrada}
gastos: gastos = 0 {class: entrada}
x: x = 1 {class: entrada}
n: n {class: entrada}
bucle1: x <= n {class: decision}

operarcion: "acer claculo" {
  class: entrada
}

inicio -> cont1 -> cont2 -> gastos -> x -> n -> bucle1
