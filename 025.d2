direction: down

classes: {
  start-end: {
    shape: oval
  }
  io: {
    shape: parallelogram
  }
  proc: {
    shape: rectangle
  }
  dec: {
    shape: diamond
  }
}

ini: "Inicio" {class: start-end}
l1: "Leer num1" {class: io}
l2: "Leer num2" {class: io}
l3: "Leer num3" {class: io}
d1: "num1<10 || num2<10 || num3<10 ?" {class: dec}
o1: "Imprimir \"Al menos uno de los valores es menor a 10\"" {class: io}
fin: "Fin" {class: start-end}

ini -> l1 -> l2 -> l3 -> d1
d1 -> o1: "Sí"
o1 -> fin
d1 -> fin: "No"
