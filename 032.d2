direction: down

classes: {
  start-end: {
    shape: oval
  }
  io: {
    shape: parallelogram
  }
  proc: {
    shape: rectangle
  }
  dec: {
    shape: diamond
  }
}

ini: "Inicio" {class: start-end}
l1: "Leer n (nº de piezas)" {class: io}
c1: "x = 1, cantidad = 0" {class: proc}
d1: "x <= n ?" {class: dec}
l2: "Leer largo" {class: io}
d2: "largo>=1.20 && largo<=1.30 ?" {class: dec}
c2: "cantidad = cantidad + 1" {class: proc}
c3: "x = x + 1" {class: proc}
o1: "Imprimir cantidad" {class: io}
fin: "Fin" {class: start-end}

ini -> l1 -> c1 -> d1
d1 -> l2: "Sí"
l2 -> d2
d2 -> c2: "Sí"
d2 -> c3: "No"
c2 -> c3
c3 -> d1
d1 -> o1: "No"
o1 -> fin
