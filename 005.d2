direction: down

classes: {
  start-end: {
    shape: oval
  }
  io: {
    shape: parallelogram
  }
  proc: {
    shape: rectangle
  }
  dec: {
    shape: diamond
  }
}

ini: "Inicio" {class: start-end}
l1: "Leer num1" {class: io}
l2: "Leer num2" {class: io}
c1: "suma = num1 + num2" {class: proc}
c2: "producto = num1 * num2" {class: proc}
o1: "Imprimir suma" {class: io}
o2: "Imprimir producto" {class: io}
fin: "Fin" {class: start-end}

ini -> l1 -> l2 -> c1 -> c2 -> o1 -> o2 -> fin
