direction: down

classes: {
  start-end: {
    shape: oval
  }
  io: {
    shape: parallelogram
  }
  proc: {
    shape: rectangle
  }
  dec: {
    shape: diamond
  }
}

ini: "Inicio" {class: start-end}
l1: "Leer n" {class: io}
c1: "x = 1" {class: proc}
d1: "x <= n ?" {class: dec}
o1: "Imprimir x" {class: io}
c2: "x = x + 1" {class: proc}
fin: "Fin" {class: start-end}

ini -> l1 -> c1 -> d1
d1 -> o1: "Sí"
o1 -> c2 -> d1
d1 -> fin: "No"
