direction: down

classes: {
  start-end: {
    shape: oval
  }
  io: {
    shape: parallelogram
  }
  proc: {
    shape: rectangle
  }
  dec: {
    shape: diamond
  }
}

ini: "Inicio" {class: start-end}
l1: "Leer num1" {class: io}
l2: "Leer num2" {class: io}
d1: "num1 > num2 ?" {class: dec}
o1: "Imprimir num1" {class: io}
o2: "Imprimir num2" {class: io}
fin: "Fin" {class: start-end}

ini -> l1 -> l2 -> d1
d1 -> o1: "Sí"
d1 -> o2: "No"
o1 -> fin
o2 -> fin
