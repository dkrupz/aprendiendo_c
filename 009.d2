direction: down

classes: {
  start-end: {
    shape: oval
  }
  io: {
    shape: parallelogram
  }
  proc: {
    shape: rectangle
  }
  dec: {
    shape: diamond
  }
}

ini: "Inicio" {class: start-end}
l1: "Leer articulo (precio)" {class: io}
l2: "Leer unidades" {class: io}
c1: "total = articulo * unidades" {class: proc}
o1: "Imprimir total" {class: io}
fin: "Fin" {class: start-end}

ini -> l1 -> l2 -> c1 -> o1 -> fin
