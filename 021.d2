direction: down

classes: {
  start-end: {
    shape: oval
  }
  io: {
    shape: parallelogram
  }
  proc: {
    shape: rectangle
  }
  dec: {
    shape: diamond
  }
}

ini: "Inicio" {class: start-end}
l1: "Leer dd" {class: io}
l2: "Leer mm" {class: io}
l3: "Leer aa" {class: io}
d1: "mm==1 || mm==2 || mm==3 ?" {class: dec}
o1: "Imprimir \"primer trimestre\"" {class: io}
o2: "Imprimir \"NO primer trimestre\"" {class: io}
fin: "Fin" {class: start-end}

ini -> l1 -> l2 -> l3 -> d1
d1 -> o1: "Sí"
d1 -> o2: "No"
o1 -> fin
o2 -> fin
