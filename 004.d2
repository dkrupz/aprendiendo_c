direction: down

classes: {
  start-end: {
    shape: oval
  }
  io: {
    shape: parallelogram
  }
  proc: {
    shape: rectangle
  }
  dec: {
    shape: diamond
  }
}

ini: "Inicio" {class: start-end}
l1: "Leer lado" {class: io}
c1: "superficie = lado * lado" {class: proc}
o1: "Imprimir superficie" {class: io}
fin: "Fin" {class: start-end}

ini -> l1 -> c1 -> o1 -> fin
