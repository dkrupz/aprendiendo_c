# _flowchart.d2
classes: {
  terminal: {
    shape: rectangle
    style.border-radius: 20
  }
  entrada: {
    shape: parallelogram
  }
  proceso: {
    shape: rectangle
  }
  decision: {
    shape: diamond
  }
  salida: {
    shape: document
  }
  conector: {
    shape: circle
    width: 40
    height: 40
  }
}
