direction: down

classes: {
  start-end: {
    shape: oval
  }
  io: {
    shape: parallelogram
  }
  proc: {
    shape: rectangle
  }
  dec: {
    shape: diamond
  }
}

ini: "Inicio" {class: start-end}
l1: "Leer num1" {class: io}
l2: "Leer num2" {class: io}
d1: "num1 > num2 ?" {class: dec}

c1: "suma = num1 + num2" {class: proc}
o1: "Imprimir suma" {class: io}
c2: "diferencia = num1 - num2" {class: proc}
o2: "Imprimir diferencia" {class: io}

c3: "producto = num1 * num2" {class: proc}
o3: "Imprimir producto" {class: io}
c4: "division = num1 / num2" {class: proc}
o4: "Imprimir division" {class: io}

fin: "Fin" {class: start-end}

ini -> l1 -> l2 -> d1
d1 -> c1: "Sí"
c1 -> o1 -> c2 -> o2 -> fin
d1 -> c3: "No"
c3 -> o3 -> c4 -> o4 -> fin
